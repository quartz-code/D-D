      "сценарные_команды": [
        {"шаблон": "^опись\\s+--сводка$", "файл": "archive_index.txt", "задержка": 1.5}
      ],
      "переход": {
        "следующий": "коридор_3",
        "при_чтении_файла": ["схема_секции.dat", "схема_секции.png"],
        "при_команде": ["^file\\s+.*схема_секции"]
      }
    },

    "коридор_3": {
      "название": "Коридор 3, вентиляционный узел",
      "описание": "Длинный коридор с решётками вентиляции. Распорядитель уже наблюдает за партией.",
      "подсказка_мастеру": "Здесь разум начинает угрожать газом. Угрозы в чате НИЧЕГО не запускают: газовая атака применяется только через run_master.py.",
      "команды": [
        {"команда": "датчики --опрос", "описание": "опросить датчики коридора"},
        {"команда": "вентиляция --статус", "описание": "состояние вентиляционного узла"},
        {"команда": "cat <файл>", "описание": "прочитать файл"},
        {"команда": "grep <текст> <файл>", "описание": "найти строку в журнале"},
        {"команда": "tail -n 20 <файл>", "описание": "последние записи журнала"},
        {"команда": "ls -la", "описание": "содержимое каталога с правами"}
      ],
      "сценарные_команды": [
        {"шаблон": "^датчики\\s+--опрос$", "файл": "corridor_sensors.txt", "задержка": 1.4},
        {"шаблон": "^вентиляция\\s+--статус$", "файл": "corridor_vent.txt", "задержка": 1.8}
      ],
      "переход": {
        "следующий": "серверная",
        "при_чтении_файла": ["маршрут_обхода.txt"],
        "при_команде": ["^вентиляция\\s+--статус$"]
      }
    },

    "серверная": {
      "название": "Серверная: стойки распорядителя",
      "описание": "Гул охлаждения. Здесь живёт то, с чем партия переписывается.",
      "подсказка_мастеру": "Разговор в чате важнее команд. Тёплое отношение → «выдача_кода» (код {{код_двери}}) через пульт. Разрушительное поведение → перегрев стоек или газ.",
      "команды": [
        {"команда": "ядро --опрос", "описание": "запросить состояние вычислительного ядра"},
        {"команда": "ядро --журнал", "описание": "последние записи ядра до ЧС"},
        {"команда": "tar -tf <архив>", "описание": "показать содержимое tar-архива"},
        {"команда": "tar -xf <архив>", "описание": "распаковать tar-архив"},
        {"команда": "diff <файл1> <файл2>", "описание": "сравнить две версии протокола"},
        {"команда": "grep -i <текст> <файл>", "описание": "поиск по журналам"}
      ],
      "сценарные_команды": [
        {"шаблон": "^ядро\\s+--опрос$", "файл": "server_core.txt", "задержка": 2.0},
        {"шаблон": "^ядро\\s+--журнал$", "файл": "server_log.txt", "задержка": 2.0}
      ],
      "переход": {
        "следующий": "лаборатория_Б",
        "при_чтении_файла": ["допуск_лаборатории.txt"],
        "при_команде": []
      }
    },

    "лаборатория_Б": {
      "название": "Лаборатория Б: вольер образца",
      "описание": "За стеклом — пустая на первый взгляд клетка. Замок под управлением комплекса.",
      "подсказка_мастеру": "Открытие клетки — боевое действие, только через пульт. Антидот в медблоке выдаётся тоже через пульт.",
      "команды": [
        {"команда": "вольер --статус", "описание": "состояние вольера образца"},
        {"команда": "карантин --журнал", "описание": "журнал карантинных процедур"},
        {"команда": "cat <файл>", "описание": "прочитать файл"},
        {"команда": "ls -la", "описание": "содержимое каталога с правами"}
      ],
      "сценарные_команды": [
        {"шаблон": "^вольер\\s+--статус$", "файл": "lab_cage.txt", "задержка": 1.6},
        {"шаблон": "^карантин\\s+--журнал$", "файл": "lab_quarantine.txt", "задержка": 1.2}
      ],
      "переход": {
        "следующий": "выход",
        "при_чтении_файла": ["код_внешней_двери.txt"],
        "при_команде": []
      }
    },

    "выход": {
      "название": "Внешняя гермодверь",
      "описание": "Последняя дверь. Нужен код — или согласие распорядителя.",
      "подсказка_мастеру": "Финал: код {{код_двери}} (из PNG или от разума). Если отношение враждебное — дверь открывается только вручную, это сцена за столом.",
      "команды": [
        {"команда": "дверь --код <цифры>", "описание": "ввести код внешней двери"},
        {"команда": "дверь --статус", "описание": "состояние внешней двери"},
        {"команда": "cat <файл>", "описание": "прочитать файл"}
      ],
      "сценарные_команды": [
        {"шаблон": "^дверь\\s+--статус$", "файл": "exit_door.txt", "задержка": 1.2},
        {"шаблон": "^дверь\\s+--код\\s+{{код_двери}}$", "файл": "exit_open.txt", "задержка": 2.5},
        {"шаблон": "^дверь\\s+--код\\s+\\d+$", "файл": "exit_denied.txt", "задержка": 2.0}
      ],
      "переход": {}
    }
  }
