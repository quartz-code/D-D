{
  "_комментарий": "Карта этапов квеста (разделы 3 и 4 ТЗ). «команды» — контекстная справка: команда «помощь» показывает только их. «сценарные_команды» — команды, ответ на которые берётся из data/canned вместо реального выполнения. «переход» — автоматическая смена этапа.",

  "всегда": [
    {"команда": "помощь", "описание": "список команд, доступных на текущем участке"},
    {"команда": "статус", "описание": "сводка: этап, каталог, состояние связи"},
    {"команда": "связь", "описание": "как выйти на голосовой канал распорядителя"},
    {"команда": "очистить", "описание": "очистить экран консоли"},
    {"команда": "выход", "описание": "отключиться от терминала"}
  ],

  "порядок": ["шлюз", "архив", "коридор_3", "серверная", "лаборатория_Б", "выход"],

  "этапы": {
    "шлюз": {
      "название": "Шлюзовая камера внешнего периметра",
      "описание": "Партия у терминала охраны. Дверь внутрь закрыта, журнал шлюза цел.",
      "подсказка_мастеру": "Дайте игрокам освоиться с ls/cd/cat. Переход в «архив» — после чтения журнала шлюза.",
      "команды": [
        {"команда": "ls", "описание": "показать содержимое каталога"},
        {"команда": "ls -la", "описание": "показать скрытые файлы и права доступа"},
        {"команда": "cd <каталог>", "описание": "перейти в каталог"},
        {"команда": "pwd", "описание": "показать текущий каталог"},
        {"команда": "cat <файл>", "описание": "прочитать текстовый файл"},
        {"команда": "less <файл>", "описание": "постраничный просмотр"},
        {"команда": "шлюз --опрос", "описание": "опросить датчики шлюзовой камеры"}
      ],
      "сценарные_команды": [
        {"шаблон": "^шлюз\\s+--опрос$", "файл": "gate_probe.txt", "задержка": 1.2}
      ],
      "переход": {
        "следующий": "архив",
        "при_чтении_файла": ["журнал_шлюза.log"],
        "при_команде": []
      }
    },

    "архив": {
      "название": "Архив первого уровня",
      "описание": "Стеллажи с носителями. Часть файлов повреждена или переименована.",
      "подсказка_мастеру": "Ключевая головоломка: схема_секции.dat — это PNG. Внутри код {{код_двери}}. Переход в «коридор_3» — когда игроки опознают формат файла.",
      "команды": [
        {"команда": "file <файл>", "описание": "определить настоящий формат файла"},
        {"команда": "mv <файл> <новое_имя>", "описание": "переименовать файл (вернуть расширение)"},
        {"команда": "cp <файл> <копия>", "описание": "скопировать файл перед экспериментами"},
        {"команда": "strings <файл>", "описание": "вытащить читаемый текст из двоичного файла"},
        {"команда": "gunzip -c <файл>", "описание": "распаковать сжатые данные"},
        {"команда": "unzip -l <файл>", "описание": "показать содержимое архива"},
        {"команда": "base64 -d <файл>", "описание": "расшифровать base64"},
        {"команда": "chmod +r <файл>", "описание": "вернуть себе право чтения"},
        {"команда": "ls -la", "описание": "посмотреть права доступа"},
        {"команда": "опись --сводка", "описание": "запросить у комплекса опись архива"}
